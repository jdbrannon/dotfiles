/*
 * App runner / launcher theme (drun/run), styled after
 * github.com/binnewbs/arch-hyprland .config/rofi
 * colors.rasi is regenerated by matugen; see hypr/scripts/theme-switcher.sh
 */
@import "colors.rasi"

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Adwaita";
    font:                "JetBrainsMono Nerd Font 11";
    drun-display-format: "{icon} {name}";
}

window {
    transparency:      "real";
    location:          center;
    anchor:            center;
    fullscreen:        false;
    width:             1000px;
    border:            2px;
    border-color:      @accent-col;
    border-radius:     16px;
    background-color:  @bg-col;
}

mainbox {
    background-color: transparent;
    orientation:       horizontal;
    children:          [ "imagebox", "listbox" ];
}

imagebox {
    padding:           20px;
    background-color:  transparent;
    background-image:  url("~/.config/hypr/current_wallpaper", height);
    orientation:        vertical;
    children:           [ "inputbar", "dummy", "mode-switcher" ];
}

dummy {
    background-color: transparent;
}

listbox {
    spacing:           20px;
    padding:           20px;
    background-color:  transparent;
    orientation:        vertical;
    children:           [ "message", "listview" ];
}

inputbar {
    spacing:           10px;
    padding:           15px;
    border-radius:      12px;
    background-color:  @bg-col-light;
    children:           [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:            false;
    str:               "";
    background-color:  inherit;
    text-color:         @accent-col;
    font:              "JetBrainsMono Nerd Font 13";
}

entry {
    background-color: inherit;
    text-color:        @fg-col;
    cursor:            text;
    placeholder:       "Search";
    placeholder-color: @fg-col2;
}

mode-switcher {
    spacing:           10px;
    background-color:  transparent;
    text-color:         @accent-col;
}

button {
    padding:           12px;
    border-radius:      12px;
    background-color:  @bg-col-light;
    text-color:         @fg-col;
    cursor:            pointer;
}

button selected {
    background-color: @accent-col;
    text-color:         @accent-fg-col;
}

listview {
    columns:           1;
    lines:             8;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    fixed-height:      true;
    fixed-columns:     true;
    spacing:           10px;
    background-color:  transparent;
    text-color:         @fg-col;
    cursor:            "default";
}

element {
    spacing:           15px;
    padding:           8px;
    border-radius:      10px;
    background-color:  transparent;
    text-color:         @fg-col;
    cursor:            pointer;
}

element normal.normal {
    background-color: inherit;
    text-color:         inherit;
}

element normal.urgent {
    background-color: @accent-col;
    text-color:         @fg-col;
}

element normal.active {
    background-color: @accent-col;
    text-color:         @fg-col;
}

element selected.normal {
    background-color: @accent-col;
    text-color:         @accent-fg-col;
}

element selected.urgent {
    background-color: @accent-col;
    text-color:         @accent-fg-col;
}

element selected.active {
    background-color: @accent-col;
    text-color:         @accent-fg-col;
}

element-icon {
    background-color: transparent;
    text-color:         inherit;
    size:              32px;
    cursor:            inherit;
}

element-text {
    background-color:  transparent;
    text-color:         inherit;
    cursor:            inherit;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

message {
    background-color: transparent;
}

textbox {
    padding:           15px;
    border-radius:      10px;
    background-color:  @bg-col-light;
    text-color:         @fg-col;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

error-message {
    padding:           15px;
    border-radius:      20px;
    background-color:  @bg-col-light;
    text-color:         @fg-col;
}
