/*
 * Regenerated by matugen; see hypr/scripts/theme-switcher.sh
 */
@import "colors.rasi"

configuration {
    modi:           "drun,run,window";
    show-icons:     true;
    icon-theme:     "Adwaita";
    font:           "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg-col;
    border:            2px;
    border-color:      @accent-col;
    border-radius:     16px;
    padding:           16px;
    width:             600px;
    location:          center;
}

mainbox {
    background-color: transparent;
    children:          [ "inputbar", "listview" ];
    spacing:           12px;
}

inputbar {
    background-color: @bg-col-light;
    border-radius:     12px;
    padding:           10px 14px;
    children:          [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:        @accent-col;
    expand:            false;
    str:               "";
    font:              "JetBrainsMono Nerd Font 13";
}

entry {
    background-color: transparent;
    text-color:        @fg-col;
    placeholder:       "Search...";
    placeholder-color: @fg-col2;
}

listview {
    background-color: transparent;
    columns:           1;
    lines:             8;
    spacing:           4px;
    cycle:             true;
    dynamic:           true;
}

element {
    background-color: transparent;
    text-color:        @fg-col;
    border-radius:     10px;
    padding:           8px 10px;
    orientation:       horizontal;
}

element-icon {
    background-color: transparent;
    size:   3.5em;
    margin: 0 10px 0 0;
}

element-text {
    background-color: transparent;
    text-color:        @fg-col;
    vertical-align:    0.5;
}

element selected {
    background-color: @accent-col;
    text-color:        @accent-fg-col;
}

element selected element-text {
    text-color: @accent-fg-col;
}
