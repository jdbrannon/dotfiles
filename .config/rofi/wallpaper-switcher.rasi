/*
 * Wallpaper theme switcher (dmenu grid), styled after
 * github.com/NischalDawadi/Hyprlust .config/rofi/config-wallpaper.rasi
 * colors.rasi is regenerated by matugen; see hypr/scripts/theme-switcher.sh
 */
@import "colors.rasi"

configuration {
    show-icons: true;
    font:       "JetBrainsMono Nerd Font 12";
}

window {
    transparency:      "real";
    location:          center;
    anchor:            center;
    fullscreen:        false;
    width:             75%;
    border:            2px;
    border-color:      @accent-col;
    border-radius:     10px;
    background-color:  #0000001a;
}

mainbox {
    background-color: transparent;
    children:          [ "inputbar", "listview" ];
}

inputbar {
    text-color:        @fg-col2;
    background-color:  transparent;
    padding:           5px;
    margin:            10px;
    children:          [ "entry" ];
}

entry {
    background-color: transparent;
    text-color:        inherit;
    placeholder:       "Search wallpapers";
    placeholder-color: inherit;
}

listview {
    columns:           5;
    lines:             1;
    padding:           26px 36px;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    reverse:           false;
    fixed-height:      true;
    fixed-columns:     true;
    spacing:           20px;
    background-color:  transparent;
    border:            0px;
}

element {
    orientation:       vertical;
    expand:            false;
    spacing:           0px;
    padding:           5px 10px;
    border-radius:      10px;
    background-color:  #00000000;
    cursor:            pointer;
}

element normal.normal {
    background-color: #00000033;
    text-color:         inherit;
}

element normal.urgent {
    background-color: #00000000;
    text-color:         @fg-col;
}

element normal.active {
    background-color: #00000000;
    text-color:         @fg-col;
}

element selected.normal {
    background-color: @accent-col;
    text-color:         @accent-fg-col;
}

element alternate.normal {
    background-color: #00000033;
    text-color:         inherit;
}

element alternate.urgent {
    background-color: #00000000;
    text-color:         inherit;
}

element alternate.active {
    background-color: #00000000;
    text-color:         inherit;
}

element-icon {
    size:              50%;
    cursor:            inherit;
    expand:            false;
    padding:           0px;
    background-color:  #00000000;
}

element-text {
    cursor:            inherit;
    background-color:  transparent;
    padding-left:       10px;
}
