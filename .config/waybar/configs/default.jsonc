{
  "layer": "top",
  "include": [
    "~/.config/waybar/modules.jsonc",
    "~/.config/waybar/modules-groups.jsonc",
    "~/.config/waybar/modules-custom.jsonc",
    "~/.config/waybar/workspaces.jsonc"
  ],
  "modules-left": [
    "group/system-info",
    "group/media"
  ],
  "modules-center": [
    "hyprland/workspaces#rw"
  ],
  "modules-right": [
    "group/moment",
    "group/control-center"
  ]
}
