{
  "group/volume": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },
  "group/control-center": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth",
      "pulseaudio",
      "battery",
      "custom/notification"
    ]
  },
  "group/system-info": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "temperature"
    ]
  },
  "group/moment": {
    "orientation": "horizontal",
    "modules": [
      "custom/clock",
      "custom/weather"
    ]
  }
}
