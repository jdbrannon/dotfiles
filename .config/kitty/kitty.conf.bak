background_opacity 0.8
scrollbar_handle_opacity 0
scrollbar_track_opacity 0
scrollbar_track_hover_opacity 0

confirm_os_window_close 0

dynamic_backgound_opacity yes
background_blur 1

shell /usr/bin/zsh

# Regenerated by matugen; see hypr/scripts/theme-switcher.sh
include themes/Matugen.conf

url_style curly

remember_window_size no

sync_to_monitor no

editor /usr/bin/nvim

# Paste from clipboard on right-click 
mouse_map right press ungrabbed paste_from_clipboard

# Automatically copy selected text to clipboard
copy_on_select clipboard

